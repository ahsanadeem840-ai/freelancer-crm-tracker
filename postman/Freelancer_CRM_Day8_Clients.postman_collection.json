            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clients?search=Nexus",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients"],
              "query": [
                {
                  "key": "search",
                  "value": "Nexus"
                }
              ]
            }
          }
        },
        {
          "name": "3. Paginated & Sorted Client List",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clients?page=1&limit=5&sort=-createdAt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "-createdAt"
                }
              ]
            }
          }
        },
        {
          "name": "4. Get Client Pipeline Stats & Billing Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response contains pipeline counts and financials\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property(\"total\");",
                  "    pm.expect(jsonData.data).to.have.property(\"leads\");",
                  "    pm.expect(jsonData.data).to.have.property(\"active\");",
                  "    pm.expect(jsonData.data).to.have.property(\"financials\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clients/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients", "stats"]
            }
          }
        }
