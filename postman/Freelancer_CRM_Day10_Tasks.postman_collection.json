      "name": "00 - Auth & Project Setup",
      "item": [
        {
          "name": "1. Register/Login Freelancer (Auto-Saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Saved JWT Bearer Token to {{token}}\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Task Master Freelancer\",\n  \"email\": \"task_master@crmtracker.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"freelancer\"\n}"
            },
