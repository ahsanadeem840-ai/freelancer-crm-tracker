        {
          "name": "1. Create Task (status: todo, linked to project)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Task created with 201\", function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Task is linked to project\", function () {",
                  "    pm.expect(jsonData.data.projectId).to.not.be.null;",
                  "    pm.expect(jsonData.data.status).to.equal(\"todo\");",
                  "    pm.expect(jsonData.data.isCompleted).to.equal(false);",
                  "});",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set(\"taskId\", jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
