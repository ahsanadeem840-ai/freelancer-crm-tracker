{
  "info": {
    "_postman_id": "freelancer-crm-day9-project-crud-api",
    "name": "Freelancer CRM - Din 9: Project CRUD API & Client Linking",
    "description": "Comprehensive Postman test suite for Din 9: Project CRUD API, Client-Project Relationship Linking, Pipeline Statistics, Multi-Tenancy Data Isolation, and RBAC Security in Freelancer CRM & Project Tracker.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Auth & Client Setup",
      "item": [
        {
          "name": "1. Register/Login Freelancer (Auto-Saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Saved JWT Bearer Token to {{token}}\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Muhammad Ahsan\",\n  \"email\": \"ahsan.projects@example.com\",\n  \"password\": \"SecretPassword123!\",\n  \"role\": \"freelancer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "2. Create Test Client (Auto-Saves Client ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set(\"clientId\", jsonData.data._id);",
                  "    console.log(\"Saved Client ID: \" + jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Jenkins\",\n  \"email\": \"sarah.nexus@example.com\",\n  \"company\": \"Nexus Media Labs\",\n  \"phone\": \"+1 555-492-9900\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients"]
            }
          }
        }
      ]
    },
    {
      "name": "01 - Project Creation & Linking",
      "item": [
        {
          "name": "1. Create Fixed Price Project (Linked to Client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Client link is populated\", function () {",
                  "    pm.expect(jsonData.data).to.have.property('clientId');",
                  "    pm.expect(jsonData.data.clientId).to.have.property('name');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set(\"projectId\", jsonData.data._id);",
                  "    console.log(\"Saved Project ID: \" + jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"E-Commerce Web Platform Re-architecture\",\n  \"description\": \"Migrating existing monolithic storefront to modern Next.js + Node microservices architecture with Stripe checkout.\",\n  \"clientId\": \"{{clientId}}\",\n  \"status\": \"planning\",\n  \"priority\": \"high\",\n  \"pricingType\": \"fixed\",\n  \"budget\": 6500,\n  \"startDate\": \"2026-10-01T00:00:00.000Z\",\n  \"dueDate\": \"2026-12-15T00:00:00.000Z\",\n  \"tags\": [\"FullStack\", \"NextJS\", \"Stripe\", \"HighPriority\"],\n  \"attachments\": [\n    {\n      \"name\": \"Architecture-Blueprint-v1.pdf\",\n      \"url\": \"https://s3.amazonaws.com/nexus-crm/docs/blueprint-v1.pdf\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"]
            }
          }
        },
        {
          "name": "2. Create Hourly Project (Linked to Client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"DevOps & Cloud Infrastructure Consulting\",\n  \"description\": \"AWS ECS Fargate cluster orchestration and CI/CD pipeline automation.\",\n  \"clientId\": \"{{clientId}}\",\n  \"status\": \"in_progress\",\n  \"priority\": \"medium\",\n  \"pricingType\": \"hourly\",\n  \"budget\": 3000,\n  \"hourlyRate\": 85,\n  \"tags\": [\"DevOps\", \"AWS\", \"Docker\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"]
            }
          }
        }
      ]
    },
    {
